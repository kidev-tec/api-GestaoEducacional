{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-schema.jsonx",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": ["src/**/*.ts", "!src/index.ts"],
  "reporters": ["html", "clear-text", "progress"],
  "thresholds": {
    "high": 95,
    "low": 90,
    "break": 95
  },
  "concurrency": 2,
  "timeoutMS": 15000
}
